# Required for CMS access: requests must carry this exe.dev account email
FILELOOM_OWNER_EMAIL=you@example.com

# Overrides site.json base_url for RSS, sitemap, canonical links, and local Artalk trusted domains
FILELOOM_BASE_URL=https://your-vm.exe.xyz

# Optional opt-in Content-Security-Policy profiles. Leave unset to preserve existing theme/editor behavior.
# Set either value to "default" for Fileloom's documented profile, or provide a complete header value.
# FILELOOM_CMS_CSP=default
# FILELOOM_PUBLIC_CSP=default
