{
  "title": "A Fileloom site",
  "description": "An HTML-first static site made with Fileloom.",
  "base_url": "http://localhost:8000",
  "theme": "brutalist",
  "editor_engine": "deckflow",
  "footer": "Made with Fileloom.",
  "comments": {
    "enabled": false,
    "provider": "artalk"
  },
  "git": {
    "enabled": false,
    "auto_commit": false,
    "auto_push": false,
    "commit_on": "build",
    "remote": "origin",
    "branch": "main"
  }
}
